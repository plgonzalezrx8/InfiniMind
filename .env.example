# Copy this file to .env and replace values before running in shared/staging/prod.
# Local-only quick test can use the docker-compose defaults, but do not keep defaults in real deployments.
# You can auto-generate the InfiniMind keys with:
#   python3 scripts/generate_api_keys.py --write-env

# Required by service and all callers (curl/OpenClaw bridge). Must match exactly.
INFINIMIND_API_KEY=replace-with-long-random-string

# Required for admin endpoint /v1/admin/reembed. Can be same as INFINIMIND_API_KEY in dev,
# but should be separate in production.
INFINIMIND_ADMIN_API_KEY=replace-with-different-long-random-string

# Required when embedding provider is openai.
OPENAI_API_KEY=replace-with-openai-api-key

# Optional tracing controls (disabled by default).
INFINIMIND_TRACING_ENABLED=false
INFINIMIND_TRACING_EXPORTER=otlp
# Required when tracing is enabled and exporter=otlp.
INFINIMIND_TRACING_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
INFINIMIND_TRACING_SERVICE_NAME=infinimind-service
